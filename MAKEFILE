# ==============================
# Parallel Log File Analyzer
# ==============================
CXX ?= g++
CXXFLAGS = -std=c++17 -fopenmp -O2 -Wall
INCLUDES = -Iinclude
SRC_DIR = src
BIN_DIR = bin
RAW_DIR = data/raw
CLEAN_DIR = data/clean

# Targets
SERIAL = $(BIN_DIR)/serial_analyzer
PARALLEL = $(BIN_DIR)/parallel_analyzer
BENCH = $(BIN_DIR)/benchmark
MAIN = $(BIN_DIR)/main
RUN_BENCH = $(BIN_DIR)/run_benchmark
PREPROC = $(BIN_DIR)/preprocessor

# Source files
SRC_FILES = 
OBJS = 

# Create output directories if not exists
$(shell mkdir -p $(BIN_DIR))
$(shell mkdir -p $(CLEAN_DIR))

# Build all
all: $(SERIAL) $(PARALLEL) $(BENCH) $(MAIN) $(RUN_BENCH) $(PREPROC)

$(SERIAL): $(SRC_DIR)/serial_analyzer.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) $^ -o $@

$(PARALLEL): $(SRC_DIR)/parallel_analyzer.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) $^ -o $@

$(BENCH): $(SRC_DIR)/benchmark.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) $^ -o $@

$(MAIN): $(SRC_DIR)/main.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) $^ -o $@

$(RUN_BENCH): $(SRC_DIR)/run_benchmark.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) $^ -o $@

preprocessor: src/preprocessor_main.cpp src/log_preprocessor.cpp
	$(CXX) $(CXXFLAGS) -std=c++17 -o bin/preprocessor src/preprocessor_main.cpp src/log_preprocessor.cpp $(INCLUDES)

# Clean up
clean:
	rm -rf $(BIN_DIR)/*.o $(BIN_DIR)/serial_analyzer $(BIN_DIR)/parallel_analyzer $(BIN_DIR)/benchmark $(BIN_DIR)/main $(BIN_DIR)/run_benchmark $(BIN_DIR)/preprocessor

# Run options
run-serial: $(SERIAL)
	@$(SERIAL)

run-parallel: $(PARALLEL)
	@$(PARALLEL)

run-bench: $(BENCH)
	@$(BENCH)

run-main: $(MAIN)
	@$(MAIN)

run-bench-all: $(RUN_BENCH)
	@$(RUN_BENCH)

run-preprocessor: preprocessor
	@$(PREPROC) $(RAW_DIR) $(CLEAN_DIR)

# Convenience alias
preprocess-data: run-preprocessor

# Help
help:
	@echo "Makefile commands:"
	@echo "	make all          - Build all binaries"
	@echo "	make run-serial   - Run serial version"
	@echo "	make run-parallel - Run parallel version"
	@echo "	make run-bench    - Run benchmark comparison"
	@echo "	make run-main     - Run interactive mode"
	@echo "	make clean        - Remove binaries"
